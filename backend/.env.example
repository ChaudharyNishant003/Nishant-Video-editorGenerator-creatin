# AI YT Studio v2 backend settings. Copy to backend/.env (gitignored) and fill in.
# Provider API keys (Groq, Gemini, Pexels, ...) NEVER go here — they are entered in the
# app's Settings page, kept only in the browser, and sent per request.

# Single password for the login gate
APP_PASSWORD=
# Random string (e.g. 64 hex chars) used to sign the session cookie
SESSION_SECRET=
# Where SQLite + media live (default: <repo>/data)
DATA_DIR=
# Optional
# MAX_UPLOAD_MB=300
# MAX_UPLOAD_SECONDS=180
# JOB_CONCURRENCY=1
# RETENTION_DAYS=30
# SECURE_COOKIES=1        # set when served over HTTPS
# FFMPEG_PATH=            # default: ffmpeg on PATH, else the bundled imageio-ffmpeg binary
