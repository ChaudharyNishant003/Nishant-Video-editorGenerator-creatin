{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "AI YT Studio (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "v2 backend (UAT)",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "v2 frontend (UAT)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "--config", "frontend/vite.config.ts"],
      "port": 5174
    }
  ]
}
